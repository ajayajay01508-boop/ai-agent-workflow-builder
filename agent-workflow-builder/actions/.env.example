# URL of your Hasura GraphQL endpoint, e.g. https://<subdomain>.nhost.run/v1/graphql
HASURA_GRAPHQL_URL=

# Hasura admin secret (same one configured on your nhost project)
HASURA_ADMIN_SECRET=

# Shared secret this service checks on every incoming call from Hasura
# (Actions + Event Triggers) and from the scheduled-run cron job. Set the
# same value as an env var on your Hasura/nhost project.
ACTIONS_WEBHOOK_SECRET=

# Optional — Groq free-tier API key (https://console.groq.com). If unset,
# llm_call steps use a disclosed stub with an artificial delay instead.
GROQ_API_KEY=

PORT=4000
